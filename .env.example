# Copy these names into your shell or a deployment secret manager.
# Replace the session value locally; this placeholder is not a credential.
# Runtime mode: demo enables synthetic click-through login; pilot fails closed
# until the OIDC and trusted-origin fields below are configured.
CAREFLOW_MODE=demo
CAREFLOW_DB_PATH=careflow.db
CAREFLOW_SYNTHETIC_ONLY=true
CAREFLOW_ALLOW_DEMO_LOGIN=true
CAREFLOW_TRUSTED_ORIGINS=http://127.0.0.1:8000
CAREFLOW_SESSION_SECRET=replace-with-a-long-random-secret
CAREFLOW_SESSION_MAX_AGE=3600
CAREFLOW_SESSION_IDLE_AGE=3600
CAREFLOW_SESSION_ABSOLUTE_AGE=28800
CAREFLOW_MESSAGE_PROVIDER=rule_based

# Required when CAREFLOW_MODE=pilot; placeholders only.
CAREFLOW_OIDC_ISSUER=https://issuer.example.test
CAREFLOW_OIDC_CLIENT_ID=replace-with-oidc-client-id
CAREFLOW_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
CAREFLOW_OIDC_REDIRECT_URI=https://pilot.example.test/auth/callback
